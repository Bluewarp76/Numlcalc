+LAYOUT_CORE = r"""
+/* The background is drawn as one or several panels. Each panel copies a part
+ * of the background (src, in normalized background coordinates) to a rect of
+ * the window (dst, in pixels).
+ *  - Portrait: a single panel showing the whole calculator.
+ *  - Landscape: two panels, the screen on the left and the keyboard on the
+ *    right. Panels are ordered by src.y (screen above keyboard in the
+ *    background), which lets us find the panel of any point from its y. */
+struct Panel {
+  SDL_FRect src;
+  SDL_Rect dst;
+};
+constexpr static int MaxNumberOfPanels = 2;
+static Panel sPanels[MaxNumberOfPanels];
+static int sNumberOfPanels = 1;
+static SDL_Rect sFrame;
+
+static const Panel * panelForY(float y) {
+  for (int i = sNumberOfPanels - 1; i > 0; i--) {
+    if (y >= sPanels[i].src.y) {
+      return &sPanels[i];
+    }
+  }
+  return &sPanels[0];
+}
+
+static float panelScaleX(const Panel * p) { return static_cast<float>(p->dst.w) / p->src.w; }
+static float panelScaleY(const Panel * p) { return static_cast<float>(p->dst.h) / p->src.h; }
+
+static void makeAbsolute(const SDL_FRect f, SDL_Rect * r) {
+  const Panel * p = panelForY(f.y + f.h / 2.0f);
+  r->x = std::round((f.x - p->src.x) * panelScaleX(p) + static_cast<float>(p->dst.x));
+  r->y = std::round((f.y - p->src.y) * panelScaleY(p) + static_cast<float>(p->dst.y));
+  r->w = std::round(f.w * panelScaleX(p));
+  r->h = std::round(f.h * panelScaleY(p));
+}
+
+static void makeAbsolute(const SDL_FPoint f, SDL_Point * pt) {
+  const Panel * p = panelForY(f.y);
+  pt->x = (f.x - p->src.x) * panelScaleX(p) + p->dst.x;
+  pt->y = (f.y - p->src.y) * panelScaleY(p) + p->dst.y;
+}
+
+// Ratio width/height in pixels of a normalized area of the background
+static float pixelRatio(const SDL_FRect & area) {
+  return (area.w * static_cast<float>(backgroundWidth)) / (area.h * static_cast<float>(backgroundHeight));
+}
+
+static void recomputePortrait(float windowWidth, float windowHeight) {
+  float aoiRatio = pixelRatio(areaOfInterest);
+  float windowRatio = windowWidth/windowHeight;
+  if (aoiRatio > windowRatio) {
+    // Area of interest is wider than the window: bars above and below
+    sFrame.w = windowWidth / areaOfInterest.w;
+    sFrame.h = (windowWidth / aoiRatio) / areaOfInterest.h;
+    sFrame.x = - areaOfInterest.x * sFrame.w;
+    sFrame.y = (windowHeight - windowWidth/aoiRatio)/2 - areaOfInterest.y * sFrame.h;
+  } else {
+    // Area of interest is taller than the window: bars on the sides
+    sFrame.h = windowHeight / areaOfInterest.h;
+    sFrame.w = (windowHeight * aoiRatio) / areaOfInterest.w;
+    sFrame.y = - areaOfInterest.y * sFrame.h;
+    sFrame.x = (windowWidth - windowHeight*aoiRatio)/2.0f - areaOfInterest.x * sFrame.w;
+  }
+  sNumberOfPanels = 1;
+  sPanels[0].src = {0.0f, 0.0f, 1.0f, 1.0f};
+  sPanels[0].dst = sFrame;
+}
+
+static void recomputeLandscape(float windowWidth, float windowHeight) {
+  // Keep the panels away from the edges (rounded corners, notches...)
+  float margin = std::round(windowHeight * 0.03f);
+  float availableHeight = windowHeight - 2.0f * margin;
+
+  // Keyboard: as tall as possible, but never more than half the width
+  float kbRatio = pixelRatio(landscapeKeyboardPanel);
+  float kbH = availableHeight;
+  float kbW = kbH * kbRatio;
+  if (kbW > windowWidth * 0.5f) {
+    kbW = windowWidth * 0.5f;
+    kbH = kbW / kbRatio;
+  }
+
+  // Screen: as large as possible in what remains on the left
+  float scrRatio = pixelRatio(landscapeScreenPanel);
+  float availableWidth = windowWidth - kbW - 3.0f * margin;
+  float scrW = availableWidth;
+  float scrH = scrW / scrRatio;
+  if (scrH > availableHeight) {
+    scrH = availableHeight;
+    scrW = scrH * scrRatio;
+  }
+
+  sNumberOfPanels = 2;
+  // Panels must be ordered by src.y, see panelForY
+  sPanels[0].src = landscapeScreenPanel;
+  sPanels[0].dst.w = std::round(scrW);
+  sPanels[0].dst.h = std::round(scrH);
+  sPanels[0].dst.x = std::round(margin + (availableWidth - scrW) / 2.0f);
+  sPanels[0].dst.y = std::round((windowHeight - scrH) / 2.0f);
+
+  sPanels[1].src = landscapeKeyboardPanel;
+  sPanels[1].dst.w = std::round(kbW);
+  sPanels[1].dst.h = std::round(kbH);
+  sPanels[1].dst.x = std::round(windowWidth - margin - kbW);
+  sPanels[1].dst.y = std::round((windowHeight - kbH) / 2.0f);
+
+  // Equivalent full background frame at the keyboard's scale
+  sFrame.w = std::round(kbW / landscapeKeyboardPanel.w);
+  sFrame.h = std::round(kbH / landscapeKeyboardPanel.h);
+  sFrame.x = std::round(sPanels[1].dst.x - landscapeKeyboardPanel.x * sFrame.w);
+  sFrame.y = std::round(sPanels[1].dst.y - landscapeKeyboardPanel.y * sFrame.h);
+}
+
+void recompute(int width, int height) {
+  float windowWidth = static_cast<float>(width);
+  float windowHeight = static_cast<float>(height);
+  if (width > height) {
+    recomputeLandscape(windowWidth, windowHeight);
+  } else {
+    recomputePortrait(windowWidth, windowHeight);
+  }
+}
+
+void getScreenRect(SDL_Rect * rect) {
+  makeAbsolute(screenRect, rect);
+}
+
+void getBackgroundRect(SDL_Rect * rect) {
+  *rect = sFrame;
+}
+
